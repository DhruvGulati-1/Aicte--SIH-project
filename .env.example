# RegulaFlow AI - Environment Variables (Smart India Hackathon 2026 - SIH26262)

# Server & Port Configuration (Render automatically injects PORT)
PORT=3000
NODE_ENV=production

# App Host URL (e.g., https://regulaflow-aicte.onrender.com or http://localhost:3000)
APP_URL=http://localhost:3000

# Optional: Google Gemini API Key for autonomous regulatory agents
# Get a free key from https://aistudio.google.com/app/apikey if needed
GEMINI_API_KEY=""

# Database Configuration (Optional external PostgreSQL on Render / Supabase / Neon)
# If omitted or unconfigured, RegulaFlow runs seamlessly in high-speed in-memory store mode.
DATABASE_URL=""

# Authentication & Security
JWT_SECRET="sih2026-aicte-regulaflow-production-secret-token"
JWT_EXPIRES_IN="7d"

# Demo Seeding Flag (Seeds AICTE approved institutions and sample applications)
ENABLE_DEMO_SEED=true
